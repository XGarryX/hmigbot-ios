{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmigbot-ios:harness:2",
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "role",
        "goal",
        "ownership",
        "fact_ids",
        "ac_ids",
        "parents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "ownership": {
          "$ref": "#/$defs/strings"
        },
        "fact_ids": {
          "$ref": "#/$defs/strings",
          "minItems": 1
        },
        "ac_ids": {
          "$ref": "#/$defs/strings"
        },
        "parents": {
          "$ref": "#/$defs/strings"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "plan_item_refs": {
          "minItems": 1,
          "$ref": "#/$defs/strings"
        },
        "mapping_reason": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "generated",
            "compile",
            "behavior",
            "visual"
          ]
        }
      },
      "additionalProperties": false
    },
    "planRequest": {
      "type": "object",
      "required": [
        "schema_version",
        "wave",
        "graph_sha256",
        "tasks"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "wave": {
          "enum": [
            "understand",
            "domains"
          ]
        },
        "graph_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "replan_review": {
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "reviewer",
            "reason"
          ]
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "ios_receipt_version",
        "task_id",
        "domain",
        "source_sha256",
        "plan_sha256",
        "status",
        "final_state",
        "behavior_verified",
        "ac_ids",
        "file_hashes",
        "files_touched",
        "fixed",
        "skipped",
        "findings"
      ],
      "properties": {
        "ios_receipt_version": {
          "const": 2
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "generated",
            "blocked"
          ]
        },
        "final_state": {
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "behavior_verified": {
          "const": false
        },
        "ac_ids": {
          "$ref": "#/$defs/strings"
        },
        "file_hashes": {
          "$ref": "#/$defs/hashes"
        },
        "files_touched": {
          "$ref": "#/$defs/strings"
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "$ref": "#/$defs/strings"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "planItem": {
      "required": [
        "item_id",
        "ac_ids",
        "ownership",
        "parents",
        "page_ids",
        "scope",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "page_ids": {
          "items": {
            "type": "string",
            "pattern": "^page_\\d{4}$"
          },
          "uniqueItems": true,
          "type": "array"
        },
        "ownership": {
          "$ref": "#/$defs/strings"
        },
        "verification": {
          "enum": [
            "generated",
            "compile",
            "behavior",
            "visual"
          ]
        },
        "scope": {
          "enum": [
            "product",
            "excluded"
          ]
        },
        "parents": {
          "$ref": "#/$defs/strings"
        },
        "item_id": {
          "type": "string",
          "pattern": "^(?:UI:PAGE-\\d{4}|BASE:Base-\\d+(?:\\.\\d+)?|SLICE:F\\d+:3[a-d]|FV:FV-\\d+)$"
        },
        "ac_ids": {
          "$ref": "#/$defs/strings"
        }
      },
      "type": "object"
    },
    "planItems": {
      "required": [
        "plan_items_version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_items_version": {
          "const": 2
        },
        "items": {
          "items": {
            "$ref": "#/$defs/planItem"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  }
}
