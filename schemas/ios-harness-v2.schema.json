{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmigbot-ios:harness:2",
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "task": {
      "type": "object", "required": ["id", "role", "goal", "ownership", "fact_ids", "ac_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "role": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1},
        "ownership": {"$ref": "#/$defs/strings", "minItems": 1},
        "fact_ids": {"$ref": "#/$defs/strings", "minItems": 1}, "ac_ids": {"$ref": "#/$defs/strings"},
        "parents": {"$ref": "#/$defs/strings"}, "model": {"type": "string", "minLength": 1}
      }
    },
    "planRequest": {
      "type": "object", "required": ["schema_version", "wave", "graph_sha256", "tasks"],
      "properties": {
        "schema_version": {"const": 2}, "wave": {"enum": ["understand", "domains"]},
        "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 8},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
        "decisions": {"type": "array", "items": {"type": "object"}}
      }
    },
    "receipt": {
      "type": "object", "required": ["ios_receipt_version", "task_id", "domain", "source_sha256", "plan_sha256", "status", "final_state", "behavior_verified", "ac_ids", "file_hashes", "files_touched", "fixed", "skipped", "findings"],
      "properties": {
        "ios_receipt_version": {"const": 2}, "task_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["generated", "blocked"]}, "final_state": {"enum": ["PASS", "BLOCKED"]},
        "behavior_verified": {"const": false}, "ac_ids": {"$ref": "#/$defs/strings"},
        "file_hashes": {"$ref": "#/$defs/hashes"}, "files_touched": {"$ref": "#/$defs/strings"},
        "fixed": {"type": "array", "items": {"type": "object"}},
        "skipped": {"type": "array", "items": {"type": "object"}},
        "findings": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
